{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=FinFlowOrion;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "FinFlowOrion",
    "CollectionName": "WebhookRawPayloads"
  },
  "Jwt": {
    "Key": "your-super-secret-key-change-in-production-min-32chars",
    "Issuer": "FinFlow.Orion",
    "Audience": "FinFlow.Orion.Clients"
  },
  "Providers": {
    "MPesa": {
      "BaseUrl": "https://sandbox.safaricom.co.ke",
      "ConsumerKey": "",
      "ConsumerSecret": "",
      "BusinessShortCode": "174379",
      "PassKey": "",
      "CallbackUrl": "https://localhost:5000/api/v1/webhooks/mpesa",
      "AccountReference": "FinFlowOrion",
      "TransactionDesc": "Payment",
      "TimeoutSeconds": 30,
      "MaxRetries": 3
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "AllowedHosts": "*"
}