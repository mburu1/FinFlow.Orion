@using FinFlow.Orion.Contracts.Reconciliation.Responses

<div class="discrepancy-table-container">
    <table class="discrepancy-table">
        <thead>
            <tr>
                <th>Payment Ref</th>
                <th>Type</th>
                <th>Internal Amount</th>
                <th>Provider Amount</th>
                <th>Difference</th>
                <th>Status</th>
                <th>Detected</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Discrepancies == null || Discrepancies.Count == 0)
            {
                <tr class="no-data-row">
                    <td colspan="8">No discrepancies found</td>
                </tr>
            }
            else
            {
                @foreach (var disc in Discrepancies)
                {
                    <tr class="@($"row-{(disc.IsResolved ? "resolved" : "unresolved")}")">
                        <td class="payment-ref-cell">
                            <span class="ref-badge">@disc.PaymentReference</span>
                        </td>
                        <td>
                            <span class="@($"type-badge type-{disc.DiscrepancyType?.ToLower()}")">
                                @disc.DiscrepancyType
                            </span>
                        </td>
                        <td class="amount-cell">
                            @disc.InternalAmount.ToString("C")
                        </td>
                        <td class="amount-cell">
                            @disc.ProviderAmount.ToString("C")
                        </td>
                        <td class="difference-cell">
                            <span class="@($"diff-badge diff-{(disc.DifferenceAmount > 0 ? "positive" : "negative")}")">
                                @disc.DifferenceAmount.ToString("C")
                            </span>
                        </td>
                        <td>
                            <span class="@($"status-badge status-{(disc.IsResolved ? "resolved" : "unresolved")}")">
                                @(disc.IsResolved ? "✓ Resolved" : "⚠ Unresolved")
                            </span>
                        </td>
                        <td class="timestamp-cell">
                            @disc.DetectedAt.ToString("yyyy-MM-dd HH:mm")
                        </td>
                        <td class="actions-cell">
                            <button class="btn-view-disc" @onclick="@(() => OnViewDiscrepancy.InvokeAsync(disc.DiscrepancyId))">
                                View
                            </button>
                            @if (!disc.IsResolved)
                            {
                                <button class="btn-resolve" @onclick="@(() => OnResolve.InvokeAsync(disc.DiscrepancyId))">
                                    Resolve
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter]
    public List<DiscrepancyResponse> Discrepancies { get; set; } = new();

    [Parameter]
    public EventCallback<Guid> OnViewDiscrepancy { get; set; }

    [Parameter]
    public EventCallback<Guid> OnResolve { get; set; }
}

<style>
    .discrepancy-table-container {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .discrepancy-table {
        width: 100%;
        border-collapse: collapse;
    }

        .discrepancy-table thead {
            background: #f0f0f0;
        }

        .discrepancy-table th {
            padding: 12px 14px;
            text-align: left;
            font-weight: 600;
            color: #1a1a1a;
            border-bottom: 2px solid #ddd;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .discrepancy-table td {
            padding: 12px 14px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

        .discrepancy-table tbody tr:hover {
            background: #f9f9f9;
        }

    .row-unresolved {
        background: #fffbf0;
    }

    .row-resolved {
        opacity: 0.7;
    }

    .no-data-row td {
        text-align: center;
        padding: 40px 14px;
        color: #999;
    }

    .payment-ref-cell {
        font-weight: 600;
    }

    .ref-badge {
        background: #e3f2fd;
        color: #0d47a1;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: 600;
        display: inline-block;
    }

    .type-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
    }

    .type-amountmismatch {
        background: #ffe0b2;
        color: #e65100;
    }

    .type-statusmismatch {
        background: #f8bbd0;
        color: #c2185b;
    }

    .type-missing {
        background: #ffcdd2;
        color: #c62828;
    }

    .amount-cell {
        font-weight: 600;
        font-family: monospace;
    }

    .difference-cell {
        font-weight: 700;
    }

    .diff-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
        font-family: monospace;
    }

    .diff-positive {
        background: #c8e6c9;
        color: #2e7d32;
    }

    .diff-negative {
        background: #ffcdd2;
        color: #c62828;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-resolved {
        background: #c8e6c9;
        color: #2e7d32;
    }

    .status-unresolved {
        background: #fff9c4;
        color: #f57f17;
    }

    .timestamp-cell {
        color: #666;
        font-size: 12px;
        font-family: monospace;
    }

    .actions-cell {
        display: flex;
        gap: 6px;
    }

    .btn-view-disc,
    .btn-resolve {
        padding: 6px 10px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 11px;
        font-weight: 600;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .btn-view-disc {
        background: #0d47a1;
        color: white;
    }

        .btn-view-disc:hover {
            background: #1565c0;
        }

    .btn-resolve {
        background: #2e7d32;
        color: white;
    }

        .btn-resolve:hover {
            background: #388e3c;
        }

    @media (max-width: 768px) {
        .discrepancy-table {
            font-size: 12px;
        }

            .discrepancy-table th,
            .discrepancy-table td {
                padding: 8px 10px;
            }

        .actions-cell {
            flex-direction: column;
        }

        .btn-view-disc,
        .btn-resolve {
            width: 100%;
        }
    }
</style>