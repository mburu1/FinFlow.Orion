@using FinFlow.Orion.Contracts.Reconciliation.Responses

<div class="discrepancy-table-container">
    <table class="discrepancy-table">
        <thead>
            <tr>
                <th>Payment Ref</th>
                <th>Type</th>
                <th>Internal Amount</th>
                <th>Provider Amount</th>
                <th>Difference</th>
                <th>Status</th>
                <th>Detected</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Discrepancies == null || Discrepancies.Count == 0)
            {
                <tr class="no-data-row">
                    <td colspan="8">No discrepancies found</td>
                </tr>
            }
            else
            {
                @foreach (var disc in Discrepancies)
                {
                    <tr class="@($"row-{(disc.IsResolved ? "resolved" : "unresolved")}")">
                        <td class="payment-ref-cell">
                            <span class="ref-badge">@disc.PaymentReference</span>
                        </td>
                        <td>
                            <span class="@($"type-badge type-{disc.DiscrepancyType?.ToLower()}")">
                                @disc.DiscrepancyType
                            </span>
                        </td>
                        <td class="amount-cell">
                            @disc.InternalAmount.ToString("C")
                        </td>
                        <td class="amount-cell">
                            @disc.ProviderAmount.ToString("C")
                        </td>
                        <td class="difference-cell">
                            <span class="@($"diff-badge diff-{(disc.DifferenceAmount > 0 ? "positive" : "negative")}")">
                                @disc.DifferenceAmount.ToString("C")
                            </span>
                        </td>
                        <td>
                            <span class="@($"status-badge status-{(disc.IsResolved ? "resolved" : "unresolved")}")">
                                @(disc.IsResolved ? "✓ Resolved" : "⚠ Unresolved")
                            </span>
                        </td>
                        <td class="timestamp-cell">
                            @disc.DetectedAt.ToString("yyyy-MM-dd HH:mm")
                        </td>
                        <td class="actions-cell">
                            <button class="btn-view-disc" @onclick="@(() => OnViewDiscrepancy.InvokeAsync(disc.DiscrepancyId))">
                                View
                            </button>
                            @if (!disc.IsResolved)
                            {
                                <button class="btn-resolve" @onclick="@(() => OnResolve.InvokeAsync(disc.DiscrepancyId))">
                                    Resolve
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter]
    public List<DiscrepancyResponse> Discrepancies { get; set; } = new();

    [Parameter]
    public EventCallback<Guid> OnViewDiscrepancy { get; set; }

    [Parameter]
    public EventCallback<Guid> OnResolve { get; set; }
}

