<div class="@($"modal-overlay {(IsVisible ? "visible" : "hidden")}")" @onclick="OnBackdropClick">
    <div class="modal-dialog" @onclick:stopPropagation="true">
        <div class="modal-header">
            <h2>Replay Webhook Event</h2>
            <button class="btn-close" @onclick="OnClose" aria-label="Close">×</button>
        </div>

        <div class="modal-body">
            <div class="info-section">
                <p class="info-text">
                    You are about to replay webhook event <strong>@WebhookEventId.ToString("N").Substring(0, 12)...</strong>
                </p>
                <p class="info-text secondary">
                    This will re-process the webhook payload through the payment pipeline.
                </p>
            </div>

            <div class="form-group">
                <label for="replay-reason">Reason for Replay (optional)</label>
                <textarea id="replay-reason"
                          class="form-control"
                          @bind="ReplayReason"
                          placeholder="e.g., Manual retry after provider issue resolution..."
                          rows="4">
                </textarea>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-error">
                    @ErrorMessage
                </div>
            }
        </div>

        <div class="modal-footer">
            <button class="btn-cancel" @onclick="OnClose" disabled="@IsLoading">
                Cancel
            </button>
            <button class="btn-confirm" @onclick="OnConfirm" disabled="@IsLoading">
                @(IsLoading ? "Replaying..." : "Replay Event")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public Guid WebhookEventId { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<(Guid WebhookEventId, string Reason)> OnConfirm { get; set; }

    private string ReplayReason = string.Empty;
    private string ErrorMessage = string.Empty;
    private bool IsLoading = false;

    private async Task OnBackdropClick()
    {
        if (!IsLoading)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task ConfirmReplay()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = string.Empty;

            await OnConfirm.InvokeAsync((WebhookEventId, ReplayReason));

            ReplayReason = string.Empty;
            await OnClose.InvokeAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error replaying webhook: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}

<style>
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
    }

        .modal-overlay.visible {
            opacity: 1;
            visibility: visible;
        }

    .modal-dialog {
        background: white;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        max-width: 450px;
        width: 90%;
        animation: slideUp 0.3s ease;
    }

    @keyframes slideUp {
        from {
            transform: translateY(20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px;
        border-bottom: 1px solid #eee;
    }

        .modal-header h2 {
            margin: 0;
            font-size: 18px;
            color: #1a1a1a;
        }

    .btn-close {
        background: none;
        border: none;
        font-size: 28px;
        color: #999;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.3s ease;
    }

        .btn-close:hover {
            color: #1a1a1a;
        }

    .modal-body {
        padding: 20px;
    }

    .info-section {
        margin-bottom: 20px;
    }

    .info-text {
        margin: 0 0 8px 0;
        color: #666;
        font-size: 14px;
        line-height: 1.5;
    }

        .info-text.secondary {
            color: #999;
            font-size: 13px;
            margin-bottom: 0;
        }

    .form-group {
        margin-bottom: 16px;
    }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
            color: #1a1a1a;
            font-size: 13px;
        }

    .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
        font-family: inherit;
        box-sizing: border-box;
        resize: vertical;
    }

        .form-control:focus {
            outline: none;
            border-color: #0d47a1;
            box-shadow: 0 0 0 3px rgba(13, 71, 161, 0.1);
        }

    .alert {
        padding: 12px 14px;
        border-radius: 4px;
        font-size: 13px;
        margin-bottom: 0;
    }

    .alert-error {
        background: #ffcdd2;
        color: #c62828;
        border: 1px solid #ef5350;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 20px;
        border-top: 1px solid #eee;
    }

    .btn-cancel,
    .btn-confirm {
        padding: 10px 16px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-cancel {
        background: #e0e0e0;
        color: #1a1a1a;
    }

        .btn-cancel:hover:not(:disabled) {
            background: #d0d0d0;
        }

    .btn-confirm {
        background: #f57f17;
        color: white;
    }

        .btn-confirm:hover:not(:disabled) {
            background: #f9a825;
        }

        .btn-cancel:disabled,
        .btn-confirm:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
</style>