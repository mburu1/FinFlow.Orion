<div class="@($"modal-overlay {(IsVisible ? "visible" : "hidden")}")" @onclick="OnBackdropClick">
    <div class="modal-dialog" @onclick:stopPropagation="true">
        <div class="modal-header">
            <h2>Replay Webhook Event</h2>
            <button class="btn-close" @onclick="OnClose" aria-label="Close">×</button>
        </div>

        <div class="modal-body">
            <div class="info-section">
                <p class="info-text">
                    You are about to replay webhook event
                    <strong>@WebhookEventId.ToString("N").Substring(0, 12)...</strong>
                </p>
                <p class="info-text secondary">
                    This will re-process the webhook payload through the payment pipeline.
                </p>
            </div>

            <div class="form-group">
                <label for="replay-reason">Reason for Replay (optional)</label>
                <textarea id="replay-reason"
                          class="form-control"
                          @bind="ReplayReason"
                          placeholder="e.g., Manual retry after provider issue resolution..."
                          rows="4">
                </textarea>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-error">
                    @ErrorMessage
                </div>
            }
        </div>

        <div class="modal-footer">
            <button class="btn-cancel" @onclick="OnClose" disabled="@IsLoading">
                Cancel
            </button>
            @* ✅ Fix CS1503: was @onclick="OnConfirm" — must call ConfirmReplay() instead *@
            <button class="btn-confirm" @onclick="ConfirmReplay" disabled="@IsLoading">
                @(IsLoading ? "Replaying..." : "Replay Event")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public Guid WebhookEventId { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<(Guid WebhookEventId, string Reason)> OnConfirm { get; set; }

    private string ReplayReason = string.Empty;
    private string ErrorMessage = string.Empty;
    private bool IsLoading = false;

    private async Task OnBackdropClick()
    {
        if (!IsLoading)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task ConfirmReplay()
    {
        try
        {
            IsLoading = true;
            ErrorMessage = string.Empty;
            StateHasChanged();

            await OnConfirm.InvokeAsync((WebhookEventId, ReplayReason));

            ReplayReason = string.Empty;
            await OnClose.InvokeAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error replaying webhook: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}

