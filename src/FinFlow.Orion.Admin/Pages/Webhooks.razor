@page "/webhooks"
@using FinFlow.Orion.Contracts.Common
@using FinFlow.Orion.Contracts.Webhooks.Responses
@inject ILogger<Webhooks> Logger

<div class="page-container">
    <div class="page-header">
        <h1>Webhooks</h1>
        <p>Monitor and manage incoming webhook events from payment providers</p>
    </div>

    <div class="filter-section">
        <select class="filter-select" @onchange="@((ChangeEventArgs e) => SelectedProvider = e.Value?.ToString() ?? string.Empty)">
            <option value="">All Providers</option>
            <option value="MPesa">M-Pesa</option>
            <option value="Card">Card</option>
            <option value="BankTransfer">Bank Transfer</option>
        </select>

        <select class="filter-select" @onchange="@((ChangeEventArgs e) => SelectedStatus = e.Value?.ToString() ?? string.Empty)">
            <option value="">All Statuses</option>
            <option value="Processed">Processed</option>
            <option value="Pending">Pending</option>
            <option value="Failed">Failed</option>
        </select>

        <button class="btn-primary" @onclick="LoadWebhooks">Refresh</button>
    </div>

    @if (IsLoading)
    {
        <div class="loading">Loading webhook events...</div>
    }
    else if (WebhookEvents.Count == 0)
    {
        <div class="no-data">No webhook events found</div>
    }
    else
    {
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Event ID</th>
                        <th>Provider</th>
                        <th>Event Type</th>
                        <th>Payment Ref</th>
                        <th>Status</th>
                        <th>Received</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var webhook in WebhookEvents)
                    {
                        <tr class="@($"status-{webhook.IsProcessed.ToString().ToLower()}")">
                            <td class="event-id">@webhook.WebhookEventId.ToString("N").Substring(0, 8)...</td>
                            <td>@webhook.Provider</td>
                            <td>
                                <span class="event-type">@webhook.EventType</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(webhook.PaymentReference))
                                {
                                    <span class="payment-ref">@webhook.PaymentReference</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="@($"badge badge-{(webhook.IsProcessed ? "processed" : "pending")}")">
                                    @(webhook.IsProcessed ? "Processed" : "Pending")
                                </span>
                            </td>
                            <td class="timestamp">@webhook.ReceivedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                <button class="btn-small" @onclick="@(() => ViewWebhookDetails(webhook.WebhookEventId))">View</button>
                                @if (!webhook.IsProcessed)
                                {
                                    <button class="btn-small btn-replay" @onclick="@(() => ReplayWebhook(webhook.WebhookEventId))">Replay</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination">
            <button class="btn-nav" @onclick="PreviousPage" disabled="@(CurrentPage == 1)">← Previous</button>
            <span class="page-info">Page @CurrentPage of @TotalPages</span>
            <button class="btn-nav" @onclick="NextPage" disabled="@(CurrentPage >= TotalPages)">Next →</button>
        </div>
    }

    @if (ShowReplayConfirm)
    {
        <div class="modal-overlay" @onclick="CancelReplay">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>Replay Webhook</h2>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to replay this webhook event?</p>
                    <div class="form-group">
                        <label>Reason (optional)</label>
                        <textarea class="form-control" @bind="ReplayReason" placeholder="Enter reason for replay..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-secondary" @onclick="CancelReplay">Cancel</button>
                    <button class="btn-primary" @onclick="ConfirmReplay">Replay</button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(ActionMessage))
    {
        <div class="@($"alert alert-{ActionMessageType}")">
            @ActionMessage
        </div>
    }
</div>

@code {
    private List<WebhookEventResponse> WebhookEvents = new();
    private bool IsLoading = false;
    private string SelectedProvider = string.Empty;
    private string SelectedStatus = string.Empty;
    private int CurrentPage = 1;
    private int PageSize = 20;
    private int TotalPages = 1;
    private int TotalCount = 0;

    private bool ShowReplayConfirm = false;
    private Guid SelectedWebhookId = Guid.Empty;
    private string ReplayReason = string.Empty;

    private string ActionMessage = string.Empty;
    private string ActionMessageType = string.Empty;

    private HashSet<Guid> ReplayedWebhookIds = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadWebhooks();
    }

    private async Task LoadWebhooks()
    {
        try
        {
            IsLoading = true;
            ActionMessage = string.Empty;

            // Placeholder data
            var allWebhooks = new List<WebhookEventResponse>
            {
                new WebhookEventResponse { WebhookEventId = Guid.NewGuid(), Provider = "MPesa", EventType = "PaymentCompleted", PaymentReference = "PAY-001", IsProcessed = true, ProcessingAttempts = 1, ReceivedAt = DateTime.UtcNow.AddHours(-3) },
                new WebhookEventResponse { WebhookEventId = Guid.NewGuid(), Provider = "Card", EventType = "PaymentFailed", PaymentReference = "PAY-002", IsProcessed = false, ProcessingAttempts = 0, ReceivedAt = DateTime.UtcNow.AddHours(-2) },
                new WebhookEventResponse { WebhookEventId = Guid.NewGuid(), Provider = "BankTransfer", EventType = "PaymentCompleted", PaymentReference = "PAY-003", IsProcessed = true, ProcessingAttempts = 1, ReceivedAt = DateTime.UtcNow.AddHours(-1) },
                new WebhookEventResponse { WebhookEventId = Guid.NewGuid(), Provider = "MPesa", EventType = "PaymentCompleted", PaymentReference = "PAY-004", IsProcessed = false, ProcessingAttempts = 2, ProcessingError = "Timeout", ReceivedAt = DateTime.UtcNow.AddMinutes(-30) },
                new WebhookEventResponse { WebhookEventId = Guid.NewGuid(), Provider = "Card", EventType = "PaymentCompleted", PaymentReference = "PAY-005", IsProcessed = true, ProcessingAttempts = 1, ReceivedAt = DateTime.UtcNow.AddMinutes(-15) },
            };

            TotalCount = allWebhooks.Count;
            TotalPages = (int)Math.Ceiling((double)TotalCount / PageSize);

            WebhookEvents = allWebhooks
                .Skip((CurrentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading webhooks");
            ActionMessage = "Error loading webhooks";
            ActionMessageType = "error";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ViewWebhookDetails(Guid webhookEventId)
    {
        Logger.LogInformation("Viewing webhook details: {WebhookEventId}", webhookEventId);
    }

    private void ReplayWebhook(Guid webhookEventId)
    {
        SelectedWebhookId = webhookEventId;
        ReplayReason = string.Empty;
        ShowReplayConfirm = true;
    }

    private async Task ConfirmReplay()
    {
        try
        {
            var index = WebhookEvents.FindIndex(w => w.WebhookEventId == SelectedWebhookId);
            if (index >= 0)
            {
                var old = WebhookEvents[index];
                var updated = new WebhookEventResponse
                {
                    WebhookEventId = old.WebhookEventId,
                    Provider = old.Provider,
                    EventType = old.EventType,
                    PaymentReference = old.PaymentReference,
                    ProviderTransactionId = old.ProviderTransactionId,
                    IsProcessed = false,               // init-only can be set here
                    IsReplayed = old.IsReplayed,
                    ProcessingAttempts = old.ProcessingAttempts,
                    ProcessingError = old.ProcessingError,
                    ReceivedAt = old.ReceivedAt,
                    ProcessedAt = old.ProcessedAt
                };

                WebhookEvents[index] = updated;
                ActionMessage = $"Webhook {SelectedWebhookId.ToString("N").Substring(0, 8)} queued for replay";
                ActionMessageType = "success";
            }

            ShowReplayConfirm = false;
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error replaying webhook");
            ActionMessage = "Error replaying webhook";
            ActionMessageType = "error";
        }
    }

    private void CancelReplay()
    {
        ShowReplayConfirm = false;
        ReplayReason = string.Empty;
    }

    private async Task NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
            await LoadWebhooks();
        }
    }

    private async Task PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            await LoadWebhooks();
        }
    }

    private bool IsEffectivelyProcessed(WebhookEventResponse w) =>
        w.IsProcessed || !ReplayedWebhookIds.Contains(w.WebhookEventId); // adjust logic to match desired UI
}

