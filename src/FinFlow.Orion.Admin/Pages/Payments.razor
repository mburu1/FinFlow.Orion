@page "/payments"
@using FinFlow.Orion.Contracts.Common
@using FinFlow.Orion.Contracts.Payments.Responses
@inject IPaymentService PaymentService
@inject ILogger<Payments> Logger

<div class="page-container">
    <div class="page-header">
        <h1>Payments</h1>
        <p>Browse and manage all payment transactions</p>
    </div>

    <div class="controls">
        <input type="text"
               placeholder="Search by Payment ID or Reference..."
               class="search-box"
               @onchange="@((ChangeEventArgs e) => SearchTerm = e.Value?.ToString() ?? string.Empty)" />

        <select class="filter-select" @onchange="@((ChangeEventArgs e) => SelectedStatus = e.Value?.ToString() ?? string.Empty)">
            <option value="">All Statuses</option>
            <option value="Pending">Pending</option>
            <option value="Captured">Captured</option>
            <option value="Failed">Failed</option>
            <option value="Reversed">Reversed</option>
        </select>

        <button class="btn-primary" @onclick="LoadPayments">Refresh</button>
    </div>

    @if (IsLoading)
    {
        <div class="loading">Loading payments...</div>
    }
    else if (Payments.Count == 0)
    {
        <div class="no-data">No payments found</div>
    }
    else
    {
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Amount</th>
                        <th>Provider</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Payments)
                    {
                        <tr class="@($"status-{payment.Status?.ToLower()}")">
                            <td class="ref-cell">@payment.Reference</td>
                            <td class="amount-cell">@payment.Amount.ToString("C")</td>
                            <td>@payment.Provider</td>
                            <td>
                                <span class="@($"badge badge-{payment.Status?.ToLower()}")">
                                    @payment.Status
                                </span>
                            </td>
                            <td>@payment.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                <button class="btn-small" @onclick="@(() => ViewPaymentDetails(payment.PaymentId))">View</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<PaymentSummaryDto> Payments = new();
    private bool IsLoading = false;
    private string SearchTerm = string.Empty;
    private string SelectedStatus = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPayments();
    }

    private async Task LoadPayments()
    {
        try
        {
            IsLoading = true;
            // Placeholder data
            Payments = new List<PaymentSummaryDto>
            {
                new PaymentSummaryDto { PaymentId = Guid.NewGuid(), Reference = "PAY-001", Amount = 5000, CurrencyCode = "KES", Status = "Captured", Provider = "MPesa", CreatedAt = DateTime.UtcNow.AddHours(-2) },
                new PaymentSummaryDto { PaymentId = Guid.NewGuid(), Reference = "PAY-002", Amount = 15000, CurrencyCode = "KES", Status = "Pending", Provider = "Card", CreatedAt = DateTime.UtcNow.AddHours(-1) },
                new PaymentSummaryDto { PaymentId = Guid.NewGuid(), Reference = "PAY-003", Amount = 8500, CurrencyCode = "KES", Status = "Failed", Provider = "BankTransfer", CreatedAt = DateTime.UtcNow.AddMinutes(-30) },
            };
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading payments");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ViewPaymentDetails(Guid paymentId)
    {
        Logger.LogInformation("Viewing payment details: {PaymentId}", paymentId);
    }
}

<style>
