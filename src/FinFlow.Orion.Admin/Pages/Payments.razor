        color: #2e7d32;
    }

    .badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-captured {
        background: #c8e6c9;
        color: #2e7d32;
    }

    .badge-pending {
        background: #fff9c4;
        color: #f57f17;
    }

    .badge-failed {
        background: #ffcdd2;
        color: #c62828;
    }

    .badge-reversed {
        background: #e1bee7;
        color: #6a1b9a;
    }
</style>